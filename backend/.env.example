# Copie este arquivo para ".env" e ajuste os valores.
# O servidor funciona sem o .env (usa os valores padrão), mas sem a chave do Gemini
# o assistente e a análise de relatórios funcionam em "modo local".

PORT=3333
JWT_SECRET=troque-esta-chave-por-um-texto-longo-e-aleatorio
DB_FILE=./data/acorde.db

# Chave da API do Gemini, criada em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000

# Limite de consultas à IA por usuário a cada 10 minutos
AI_REQUESTS_PER_WINDOW=20
