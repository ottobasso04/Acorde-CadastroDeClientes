# Copie este arquivo para ".env" e ajuste os valores.
# O servidor funciona sem o .env (usa os valores padrão abaixo),
# mas em um projeto real o JWT_SECRET nunca deve ficar no código.

# Porta em que a API vai escutar
PORT=3333

# Chave usada para assinar os tokens de login. Troque por um texto longo e aleatório.
JWT_SECRET=troque-esta-chave-por-um-texto-longo-e-aleatorio

# Caminho do arquivo do banco de dados SQLite (criado automaticamente)
DB_FILE=./data/acorde.db
